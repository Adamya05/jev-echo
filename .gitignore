# Secrets -- .env holds a live TypeSafe API key. This file must exist
# BEFORE `git init`; a key committed once stays in the history.
.env
.env.*
!.env.example

# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data and artifacts produced by the runs
results/*
# shipped: the trained Echo and the held-out results the page reports
!results/heldout_crash.json
!results/heldout_crash_echo.json
!results/heldout_crash_tree.json
*.npz
!results/student_board_crash.npz

# macOS
.DS_Store

# Local tooling
.claude/
.impeccable/
